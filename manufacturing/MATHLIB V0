      - { name: "haz_width", expr: "laser_haz_scale*exp(laser_haz_k0+(laser_haz_k1*ln(absorbed_heat_per_length/laser_haz_q_ref))+(laser_haz_k2*ln(travel_speed/laser_haz_v_ref)))", variables: ["laser_haz_scale", "laser_haz_k0", "laser_haz_k1", "laser_haz_k2", "absorbed_heat_per_length", "laser_haz_q_ref", "travel_speed", "laser_haz_v_ref"] }
    constraints: ["laser_haz_scale>0", "laser_haz_q_ref>0", "laser_haz_v_ref>0", "absorbed_heat_per_length>0", "travel_speed>0", "(absorbed_heat_per_length/laser_haz_q_ref)>0", "(travel_speed/laser_haz_v_ref)>0", "isfinite(laser_haz_scale) and isfinite(laser_haz_k0) and isfinite(laser_haz_k1) and isfinite(laser_haz_k2)", "isfinite(absorbed_heat_per_length) and isfinite(laser_haz_q_ref) and isfinite(travel_speed) and isfinite(laser_haz_v_ref)"]
    calibration:
      required: true
      storage_path: "manufacturing/calibration/subtractive_laser_haz_template/calibration.yaml"
      parameters:
        - { id: "laser_haz_scale", unit: "m" }
        - { id: "laser_haz_k0", unit: "1" }
        - { id: "laser_haz_k1", unit: "1" }
        - { id: "laser_haz_k2", unit: "1" }
        - { id: "laser_haz_q_ref", unit: "J/m" }
        - { id: "laser_haz_v_ref", unit: "m/s" }
      data_requirements:
