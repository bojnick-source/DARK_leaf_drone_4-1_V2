  - id: "metrology_spacing_from_speed_and_rate"
    domain: "metrology"
    purpose: "Along-track point spacing from speed and sample rate."
    equations:
      - { name: "point_spacing", expr: "scan_speed/sample_rate", variables: ["scan_speed", "sample_rate"] }
    constraints: ["sample_rate>0", "(sample_rate)!=0", "scan_speed>=0", "isfinite(scan_speed) and isfinite(sample_rate)"]
    outputs: [{ id: "point_spacing", unit: "m" }]

  - id: "metrology_raster_scan_time_with_overlap"
    domain: "metrology"
    purpose: "Raster scan time estimate using effective line spacing from stepover and overlap."
    equations:
      - name: "raster_time"
        expr: "(scan_width/scan_speed)*(scan_height/(tool_stepover*(1-overlap_fraction)))"
        variables: ["scan_width", "scan_speed", "scan_height", "tool_stepover", "overlap_fraction"]
        assumptions:
          - "Ignores acceleration/turnaround overhead; deterministic planning primitive."
    constraints:
      - "scan_width>0"
      - "scan_height>0"
      - "scan_speed>0"
      - "tool_stepover>0"
      - "overlap_fraction>=0 and overlap_fraction<1"
      - "(1-overlap_fraction)>0"
      - "(tool_stepover*(1-overlap_fraction))>0"
      - "isfinite(scan_width) and isfinite(scan_height) and isfinite(scan_speed) and isfinite(tool_stepover) and isfinite(overlap_fraction)"
    outputs: [{ id: "raster_time", unit: "s" }]

  - id: "metrology_point_density_and_count"
    domain: "metrology"
    purpose: "Estimate point density and point count from along-track spacing and effective line spacing."
    equations:
      - name: "point_density"
        expr: "1/(point_spacing*(tool_stepover*(1-overlap_fraction)))"
        variables: ["point_spacing", "tool_stepover", "overlap_fraction"]
        assumptions:
          - "Assumes approximately uniform sampling grid."
      - name: "point_count"
        expr: "scan_width*scan_height*(1/(point_spacing*(tool_stepover*(1-overlap_fraction))))"
        variables: ["scan_width", "scan_height", "point_spacing", "tool_stepover", "overlap_fraction"]
    constraints:
      - "point_spacing>0"
      - "tool_stepover>0"
      - "overlap_fraction>=0 and overlap_fraction<1"
      - "(1-overlap_fraction)>0"
      - "(point_spacing*(tool_stepover*(1-overlap_fraction)))!=0"
      - "scan_width>0 and scan_height>0"
      - "isfinite(scan_width) and isfinite(scan_height) and isfinite(point_spacing) and isfinite(tool_stepover) and isfinite(overlap_fraction)"
    outputs:
      - { id: "point_density", unit: "1/m^2" }
      - { id: "point_count", unit: "1" }

  - id: "metrology_lidar_range_from_tof"
    domain: "metrology"
    purpose: "LiDAR range from time-of-flight delta time."
    equations:
      - { name: "lidar_range", expr: "c_light*tof_dt/2", variables: ["c_light", "tof_dt"] }
    constraints: ["c_light>0", "tof_dt>=0", "isfinite(c_light) and isfinite(tof_dt)"]
    outputs: [{ id: "lidar_range", unit: "m" }]

  - id: "metrology_lidar_range_noise_from_jitter"
    domain: "metrology"
    purpose: "Range noise standard deviation induced by timing jitter."
    equations:
      - { name: "range_noise", expr: "c_light*timing_jitter/2", variables: ["c_light", "timing_jitter"] }
    constraints: ["c_light>0", "timing_jitter>=0", "isfinite(c_light) and isfinite(timing_jitter)"]
    outputs: [{ id: "range_noise", unit: "m" }]

  - id: "metrology_angular_step_to_arc_spacing"
    domain: "metrology"
    purpose: "Arc spacing from angular step at a given range."
    equations:
      - { name: "arc_spacing", expr: "lidar_range*angular_step", variables: ["lidar_range", "angular_step"] }
    constraints: ["lidar_range>=0", "angular_step>0", "isfinite(lidar_range) and isfinite(angular_step)"]
    outputs: [{ id: "arc_spacing", unit: "m" }]

  - id: "metrology_uncertainty_rss_and_expanded"
    domain: "metrology"
    purpose: "Combine uncertainty components by RSS and compute expanded uncertainty with explicit coverage factor."
    equations:
      - { name: "combined_uncertainty", expr: "sqrt((u_component_1^2)+(u_component_2^2)+(u_component_3^2))", variables: ["u_component_1", "u_component_2", "u_component_3"] }
      - { name: "expanded_uncertainty_u95", expr: "coverage_factor_k*sqrt((u_component_1^2)+(u_component_2^2)+(u_component_3^2))", variables: ["coverage_factor_k", "u_component_1", "u_component_2", "u_component_3"] }
    constraints:
      - "u_component_1>=0 and u_component_2>=0 and u_component_3>=0"
      - "coverage_factor_k>0"
      - "((u_component_1^2)+(u_component_2^2)+(u_component_3^2))>=0"
      - "isfinite(coverage_factor_k) and isfinite(u_component_1) and isfinite(u_component_2) and isfinite(u_component_3)"
    outputs:
      - { id: "combined_uncertainty", unit: "m" }
      - { id: "expanded_uncertainty_u95", unit: "m" }

  - id: "metrology_motion_blur_position_error"
    domain: "metrology"
    purpose: "Position error due to motion during exposure/integration."
    equations:
      - { name: "motion_blur_error", expr: "scan_speed*exposure_time", variables: ["scan_speed", "exposure_time"] }
    constraints: ["scan_speed>=0", "exposure_time>=0", "isfinite(scan_speed) and isfinite(exposure_time)"]
    outputs: [{ id: "motion_blur_error", unit: "m" }]

  - id: "metrology_trigger_jitter_position_error"
    domain: "metrology"
    purpose: "Position error due to trigger timing jitter at speed."
    equations:
      - { name: "trigger_jitter_error", expr: "scan_speed*trigger_jitter", variables: ["scan_speed", "trigger_jitter"] }
    constraints: ["scan_speed>=0", "trigger_jitter>=0", "isfinite(scan_speed) and isfinite(trigger_jitter)"]
    outputs: [{ id: "trigger_jitter_error", unit: "m" }]

  - id: "metrology_pointcloud_size_and_io_time"
    domain: "metrology"
    purpose: "Deterministic planning for point cloud size and I/O time."
    equations:
      - { name: "pointcloud_size", expr: "point_count*point_size_bytes", variables: ["point_count", "point_size_bytes"] }
      - { name: "io_time", expr: "(point_count*point_size_bytes)/io_bandwidth", variables: ["point_count", "point_size_bytes", "io_bandwidth"] }
    constraints:
      - "point_count>=0"
      - "point_size_bytes>0"
      - "io_bandwidth>0"
      - "(io_bandwidth)!=0"
      - "isfinite(point_count) and isfinite(point_size_bytes) and isfinite(io_bandwidth)"
    outputs:
      - { id: "pointcloud_size", unit: "B" }
      - { id: "io_time", unit: "s" }

