    - { id: "kg/s", name: "kilograms_per_second", symbol: "kg/s", quantity: "mass_flow", dimension: { L: 0, M: 1, T: -1, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "m^3/s", name: "cubic_meters_per_second", symbol: "m^3/s", quantity: "volumetric_flow", dimension: { L: 3, M: 0, T: -1, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "kg/m", name: "kilograms_per_meter", symbol: "kg/m", quantity: "linear_mass_density", dimension: { L: -1, M: 1, T: 0, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "kg/m^2", name: "kilograms_per_square_meter", symbol: "kg/m^2", quantity: "areal_mass_density", dimension: { L: -2, M: 1, T: 0, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
