  base_dimensions:
    L: "length"
    M: "mass"
    T: "time"
    I: "electric_current"
    TH: "thermodynamic_temperature"
    N: "amount_of_substance"
    J: "luminous_intensity"
  prefixes:
    - { id: "nano", name: "nano", symbol: "n", factor: 1.0e-9 }
    - { id: "micro", name: "micro", symbol: "u", factor: 1.0e-6 }
    - { id: "milli", name: "milli", symbol: "m", factor: 1.0e-3 }
    - { id: "centi", name: "centi", symbol: "c", factor: 1.0e-2 }
    - { id: "deci", name: "deci", symbol: "d", factor: 1.0e-1 }
    - { id: "deka", name: "deka", symbol: "da", factor: 1.0e1 }
    - { id: "hecto", name: "hecto", symbol: "h", factor: 1.0e2 }
    - { id: "kilo", name: "kilo", symbol: "k", factor: 1.0e3 }
    - { id: "mega", name: "mega", symbol: "M", factor: 1.0e6 }
    - { id: "giga", name: "giga", symbol: "G", factor: 1.0e9 }
  base_units:
    - { id: "m", name: "meter", symbol: "m", quantity: "length", dimension: { L: 1, M: 0, T: 0, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "kg", name: "kilogram", symbol: "kg", quantity: "mass", dimension: { L: 0, M: 1, T: 0, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "s", name: "second", symbol: "s", quantity: "time", dimension: { L: 0, M: 0, T: 1, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "A", name: "ampere", symbol: "A", quantity: "electric_current", dimension: { L: 0, M: 0, T: 0, I: 1, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "K", name: "kelvin", symbol: "K", quantity: "thermodynamic_temperature", dimension: { L: 0, M: 0, T: 0, I: 0, TH: 1, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "mol", name: "mole", symbol: "mol", quantity: "amount_of_substance", dimension: { L: 0, M: 0, T: 0, I: 0, TH: 0, N: 1, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "cd", name: "candela", symbol: "cd", quantity: "luminous_intensity", dimension: { L: 0, M: 0, T: 0, I: 0, TH: 0, N: 0, J: 1 }, to_SI: { scale: 1.0, offset: 0.0 } }
