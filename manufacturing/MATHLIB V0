  - id: "additive_binderjet_scale_compensation"
    domain: "additive"
    purpose: "Scale compensation from calibrated linear shrinkage (binder-jet/sintering template)."
    equations:
      - { name: "scale_compensation", expr: "1/(1-linear_shrinkage)", variables: ["linear_shrinkage"] }
    constraints: ["linear_shrinkage>=0", "linear_shrinkage<1", "(1-linear_shrinkage)!=0", "isfinite(linear_shrinkage)"]
    calibration:
