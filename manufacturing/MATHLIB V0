    domain: "subtractive"
    purpose: "Waterjet kerf offset template (calibration required)."
    equations:
      - { name: "wjet_kerf_offset", expr: "wjet_kerf_scale*exp(wjet_kerf_k0+(wjet_kerf_k1*ln(hydraulic_power/wjet_hp_ref))+(wjet_kerf_k2*ln(abrasive_dose_per_length/wjet_md_ref))+(wjet_kerf_k3*ln(travel_speed/wjet_v_ref)))", variables: ["wjet_kerf_scale", "wjet_kerf_k0", "wjet_kerf_k1", "wjet_kerf_k2", "wjet_kerf_k3", "hydraulic_power", "wjet_hp_ref", "abrasive_dose_per_length", "wjet_md_ref", "travel_speed", "wjet_v_ref"] }
    constraints: ["wjet_kerf_scale>0", "wjet_hp_ref>0 and wjet_md_ref>0 and wjet_v_ref>0", "hydraulic_power>0", "abrasive_dose_per_length>0", "travel_speed>0", "(hydraulic_power/wjet_hp_ref)>0", "(abrasive_dose_per_length/wjet_md_ref)>0", "(travel_speed/wjet_v_ref)>0", "isfinite(wjet_kerf_scale) and isfinite(wjet_kerf_k0) and isfinite(wjet_kerf_k1) and isfinite(wjet_kerf_k2) and isfinite(wjet_kerf_k3)", "isfinite(hydraulic_power) and isfinite(wjet_hp_ref) and isfinite(abrasive_dose_per_length) and isfinite(wjet_md_ref) and isfinite(travel_speed) and isfinite(wjet_v_ref)"]
