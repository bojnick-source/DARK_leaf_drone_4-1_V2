  - { id: "section_width", name: "section_width", unit: "m", kind: "input", domains: ["structures"], description: "Section width at the point where shear stress is evaluated.", domain_constraints: ["section_width>0", "isfinite(section_width)"] }
  - { id: "shear_stress", name: "shear_stress", unit: "Pa", kind: "output", domains: ["structures"], description: "Beam shear stress.", domain_constraints: ["isfinite(shear_stress)"] }
  - { id: "buckling_k", name: "buckling_coefficient_k", unit: "1", kind: "input", domains: ["structures"], description: "Plate buckling coefficient (boundary condition / mode dependent).", domain_constraints: ["buckling_k>0", "isfinite(buckling_k)"] }
  - { id: "youngs_modulus", name: "youngs_modulus", unit: "Pa", kind: "input", domains: ["structures"], description: "Young's modulus.", domain_constraints: ["youngs_modulus>0", "isfinite(youngs_modulus)"] }
  - { id: "poisson_ratio", name: "poisson_ratio", unit: "1", kind: "input", domains: ["structures"], description: "Poisson's ratio.", domain_constraints: ["isfinite(poisson_ratio)"] }
  - { id: "plate_thickness", name: "plate_thickness", unit: "m", kind: "input", domains: ["structures"], description: "Plate thickness.", domain_constraints: ["plate_thickness>0", "isfinite(plate_thickness)"] }
  - { id: "plate_span", name: "plate_span", unit: "m", kind: "input", domains: ["structures"], description: "Characteristic plate span for buckling formula (typically the loaded/shorter dimension).", domain_constraints: ["plate_span>0", "isfinite(plate_span)"] }
  - { id: "plate_buckling_stress", name: "plate_buckling_stress", unit: "Pa", kind: "output", domains: ["structures"], description: "Plate buckling critical stress (template).", domain_constraints: ["isfinite(plate_buckling_stress)"] }

models:
  - id: "risf_sine_law_thickness"
    domain: "risf"
    purpose: "Final thickness via sine law approximation."
    equations:
      - { name: "t_final", expr: "t_initial*cos(wall_angle)", variables: ["t_initial", "wall_angle"], assumptions: ["Sine law; constant volume; wall_angle in (0, pi/2)."] }
    constraints: ["t_initial>0", "wall_angle>0", "wall_angle<pi/2", "isfinite(t_initial) and isfinite(wall_angle)"]
    outputs: [{ id: "t_final", unit: "m" }]

  - id: "risf_sine_law_thinning_ratio"
    domain: "risf"
    purpose: "Thickness ratio implied by sine law."
    equations:
      - { name: "thinning_ratio", expr: "cos(wall_angle)", variables: ["wall_angle"], assumptions: ["Sine law; wall_angle in (0, pi/2)."] }
    constraints: ["wall_angle>0", "wall_angle<pi/2", "isfinite(wall_angle)"]
    outputs: [{ id: "thinning_ratio", unit: "1" }]

  - id: "risf_scallop_height_exact"
    domain: "risf"
    purpose: "Scallop height (exact circle geometry)."
    equations:
      - { name: "scallop_height", expr: "tool_radius-sqrt((tool_radius^2)-((tool_stepover/2)^2))", variables: ["tool_radius", "tool_stepover"] }
    constraints: ["tool_radius>0", "tool_stepover>=0", "(tool_radius^2)-((tool_stepover/2)^2)>=0", "isfinite(tool_radius) and isfinite(tool_stepover)"]
    outputs: [{ id: "scallop_height", unit: "m" }]

  - id: "risf_scallop_height_small_step"
    domain: "risf"
    purpose: "Scallop height (small-step approximation)."
    equations:
      - { name: "scallop_height_small_step", expr: "(tool_stepover^2)/(8*tool_radius)", variables: ["tool_radius", "tool_stepover"], assumptions: ["Valid when tool_stepover/tool_radius is small."] }
    constraints: ["tool_radius>0", "tool_stepover>=0", "isfinite(tool_radius) and isfinite(tool_stepover)"]
    outputs: [{ id: "scallop_height_small_step", unit: "m" }]

  - id: "risf_inverse_scallop_to_step"
    domain: "risf"
    purpose: "Inverse scallop target to step parameter."
    equations:
      - { name: "stepdown_from_scallop", expr: "2*sqrt((2*tool_radius*target_scallop_height)-(target_scallop_height^2))", variables: ["tool_radius", "target_scallop_height"] }
    constraints: ["tool_radius>0", "target_scallop_height>=0", "(2*tool_radius*target_scallop_height)-(target_scallop_height^2)>=0", "isfinite(tool_radius) and isfinite(target_scallop_height)"]
    outputs: [{ id: "stepdown_from_scallop", unit: "m" }]

  - id: "risf_aerens_axial_force_template"
    domain: "risf"
    purpose: "Aerens-family axial force template (calibration required)."
    equations:
      - name: "axial_force"
        expr: "aerens_force_scale*exp(aerens_k0+(aerens_k1*wall_angle)+(aerens_k2*ln(t_initial/aerens_t_ref))+(aerens_k3*ln(tool_radius/aerens_r_ref))+(aerens_k4*ln(tool_stepdown/aerens_dz_ref))+(aerens_k5*ln(tool_stepover/aerens_s_ref))+(aerens_k6*ln((tool_stepover/aerens_s_ref)/(tool_radius/aerens_r_ref))) )"
        variables: ["aerens_force_scale", "aerens_k0", "aerens_k1", "aerens_k2", "aerens_k3", "aerens_k4", "aerens_k5", "aerens_k6", "aerens_t_ref", "aerens_r_ref", "aerens_s_ref", "aerens_dz_ref", "t_initial", "wall_angle", "tool_radius", "tool_stepdown", "tool_stepover"]
        assumptions: ["Template only; coefficients and references must be calibrated. ln args are dimensionless ratios."]
    constraints:
      - "aerens_force_scale>0"
      - "aerens_t_ref>0 and aerens_r_ref>0 and aerens_s_ref>0 and aerens_dz_ref>0"
      - "t_initial>0 and tool_radius>0 and tool_stepdown>0 and tool_stepover>0"
      - "wall_angle>0 and wall_angle<pi/2"
      - "isfinite(aerens_force_scale) and isfinite(aerens_k0) and isfinite(aerens_k1) and isfinite(aerens_k2) and isfinite(aerens_k3) and isfinite(aerens_k4) and isfinite(aerens_k5) and isfinite(aerens_k6)"
      - "isfinite(aerens_t_ref) and isfinite(aerens_r_ref) and isfinite(aerens_s_ref) and isfinite(aerens_dz_ref)"
      - "isfinite(t_initial) and isfinite(tool_radius) and isfinite(tool_stepdown) and isfinite(tool_stepover) and isfinite(wall_angle)"
    calibration:
      required: true
      storage_path: "manufacturing/calibration/risf_aerens_axial_force_template/calibration.yaml"
      parameters:
        - { id: "aerens_force_scale", unit: "N" }
        - { id: "aerens_k0", unit: "1" }
        - { id: "aerens_k1", unit: "1" }
        - { id: "aerens_k2", unit: "1" }
        - { id: "aerens_k3", unit: "1" }
        - { id: "aerens_k4", unit: "1" }
        - { id: "aerens_k5", unit: "1" }
        - { id: "aerens_k6", unit: "1" }
        - { id: "aerens_t_ref", unit: "m" }
        - { id: "aerens_r_ref", unit: "m" }
        - { id: "aerens_s_ref", unit: "m" }
        - { id: "aerens_dz_ref", unit: "m" }
      data_requirements:
        - "Measured axial force synchronized with toolpath for known (t_initial, wall_angle, tool_radius, tool_stepdown, tool_stepover)."
        - "Sufficient span of operating conditions to avoid parameter degeneracy."
    outputs: [{ id: "axial_force", unit: "N" }]

  - id: "risf_robot_deflection_compliance_template"
    domain: "risf"
    purpose: "Robot/tool deflection via calibrated linear compliance."
    equations:
      - { name: "robot_deflection", expr: "robot_linear_compliance*axial_force", variables: ["robot_linear_compliance", "axial_force"], assumptions: ["Linear compliance valid within calibrated load regime."] }
    constraints: ["robot_linear_compliance>=0", "axial_force>=0", "isfinite(robot_linear_compliance) and isfinite(axial_force)"]
    calibration:
      required: true
      storage_path: "manufacturing/calibration/risf_robot_deflection_compliance_template/calibration.yaml"
      parameters: [{ id: "robot_linear_compliance", unit: "m/N" }]
      data_requirements:
        - "Applied force vs measured end-effector deflection under representative configuration."
        - "Calibration procedure documented in artifact."
    outputs: [{ id: "robot_deflection", unit: "m" }]

  - id: "additive_pbf_energy_densities"
    domain: "additive"
    purpose: "PBF energy density primitives (line/area/volume)."
    equations:
      - { name: "energy_line", expr: "(laser_power*process_efficiency)/scan_speed", variables: ["laser_power", "process_efficiency", "scan_speed"] }
      - { name: "energy_area", expr: "(laser_power*process_efficiency)/(scan_speed*hatch_spacing)", variables: ["laser_power", "process_efficiency", "scan_speed", "hatch_spacing"] }
      - { name: "energy_volume", expr: "(laser_power*process_efficiency)/(scan_speed*hatch_spacing*layer_thickness)", variables: ["laser_power", "process_efficiency", "scan_speed", "hatch_spacing", "layer_thickness"] }
    constraints: ["laser_power>0", "process_efficiency>=0 and process_efficiency<=1", "scan_speed>0", "hatch_spacing>0", "layer_thickness>0", "isfinite(laser_power) and isfinite(process_efficiency) and isfinite(scan_speed) and isfinite(hatch_spacing) and isfinite(layer_thickness)"]
    outputs:
      - { id: "energy_line", unit: "J/m" }
      - { id: "energy_area", unit: "J/m^2" }
      - { id: "energy_volume", unit: "J/m^3" }

  - id: "additive_waam_heat_input_per_length"
    domain: "additive"
    purpose: "WAAM heat input per length from arc electrical power and travel speed."
    equations:
      - { name: "heat_input_per_length", expr: "(arc_voltage*arc_current*process_efficiency)/travel_speed", variables: ["arc_voltage", "arc_current", "process_efficiency", "travel_speed"] }
    constraints: ["arc_voltage>0", "arc_current>0", "process_efficiency>=0 and process_efficiency<=1", "travel_speed>0", "isfinite(arc_voltage) and isfinite(arc_current) and isfinite(process_efficiency) and isfinite(travel_speed)"]
    outputs: [{ id: "heat_input_per_length", unit: "J/m" }]

  - id: "additive_vat_jacobs_working_curve"
    domain: "additive"
    purpose: "VAT Jacobs working curve template (calibration required)."
    equations:
      - { name: "cure_depth", expr: "penetration_depth*ln(exposure_energy/critical_energy)", variables: ["penetration_depth", "exposure_energy", "critical_energy"] }
    constraints: ["penetration_depth>0", "critical_energy>0", "exposure_energy>0", "(exposure_energy/critical_energy)>0", "isfinite(penetration_depth) and isfinite(exposure_energy) and isfinite(critical_energy)"]
    calibration:
