    constraints: ["vcut_scale>=0", "wjet_hp_ref>0 and wjet_md_ref>0 and wjet_v_ref>0", "hydraulic_power>0", "abrasive_dose_per_length>0", "travel_speed>0", "(hydraulic_power/wjet_hp_ref)>0", "(abrasive_dose_per_length/wjet_md_ref)>0", "(travel_speed/wjet_v_ref)>0", "isfinite(vcut_scale) and isfinite(vcut_k0) and isfinite(vcut_k1) and isfinite(vcut_k2) and isfinite(vcut_k3)", "isfinite(hydraulic_power) and isfinite(wjet_hp_ref) and isfinite(abrasive_dose_per_length) and isfinite(wjet_md_ref) and isfinite(travel_speed) and isfinite(wjet_v_ref)"]
    calibration:
      required: true
      storage_path: "manufacturing/calibration/subtractive_waterjet_vcut_template/calibration.yaml"
      parameters:
        - { id: "vcut_scale", unit: "m" }
        - { id: "vcut_k0", unit: "1" }
        - { id: "vcut_k1", unit: "1" }
        - { id: "vcut_k2", unit: "1" }
        - { id: "vcut_k3", unit: "1" }
        - { id: "wjet_hp_ref", unit: "W" }
        - { id: "wjet_md_ref", unit: "kg/m" }
        - { id: "wjet_v_ref", unit: "m/s" }
      data_requirements:
        - "Measured V-cut depth vs operating conditions with traceable metrology."
        - "Documented calibration procedure stored in artifact."
    outputs: [{ id: "v_cut_depth", unit: "m" }]

  - id: "metrology_spacing_from_speed_and_rate"
    domain: "metrology"
    purpose: "Along-track point spacing from speed and sample rate."
    equations:
      - { name: "point_spacing", expr: "scan_speed/sample_rate", variables: ["scan_speed", "sample_rate"] }
    constraints: ["sample_rate>0", "(sample_rate)!=0", "scan_speed>=0", "isfinite(scan_speed) and isfinite(sample_rate)"]
    outputs: [{ id: "point_spacing", unit: "m" }]

  - id: "metrology_raster_scan_time_with_overlap"
    domain: "metrology"
    purpose: "Raster scan time estimate using effective line spacing from stepover and overlap."
    equations:
      - name: "raster_time"
        expr: "(scan_width/scan_speed)*(scan_height/(tool_stepover*(1-overlap_fraction)))"
        variables: ["scan_width", "scan_speed", "scan_height", "tool_stepover", "overlap_fraction"]
        assumptions: ["Ignores acceleration/turnaround overhead; deterministic planning primitive."]
    constraints:
      - "scan_width>0"
      - "scan_height>0"
      - "scan_speed>0"
      - "tool_stepover>0"
      - "overlap_fraction>=0 and overlap_fraction<1"
      - "(1-overlap_fraction)>0"
      - "(tool_stepover*(1-overlap_fraction))>0"
      - "isfinite(scan_width) and isfinite(scan_height) and isfinite(scan_speed) and isfinite(tool_stepover) and isfinite(overlap_fraction)"
    outputs: [{ id: "raster_time", unit: "s" }]

  - id: "metrology_point_density_and_count"
    domain: "metrology"
    purpose: "Estimate point density and point count from along-track spacing and effective line spacing."
    equations:
      - { name: "point_density", expr: "1/(point_spacing*(tool_stepover*(1-overlap_fraction)))", variables: ["point_spacing", "tool_stepover", "overlap_fraction"], assumptions: ["Assumes approximately uniform sampling grid."] }
      - { name: "point_count", expr: "scan_width*scan_height*(1/(point_spacing*(tool_stepover*(1-overlap_fraction))))", variables: ["scan_width", "scan_height", "point_spacing", "tool_stepover", "overlap_fraction"] }
    constraints:
      - "point_spacing>0"
      - "tool_stepover>0"
      - "overlap_fraction>=0 and overlap_fraction<1"
      - "(1-overlap_fraction)>0"
      - "(point_spacing*(tool_stepover*(1-overlap_fraction)))!=0"
      - "scan_width>0 and scan_height>0"
      - "isfinite(scan_width) and isfinite(scan_height) and isfinite(point_spacing) and isfinite(tool_stepover) and isfinite(overlap_fraction)"
    outputs:
      - { id: "point_density", unit: "1/m^2" }
      - { id: "point_count", unit: "1" }

  - id: "metrology_lidar_range_from_tof"
    domain: "metrology"
    purpose: "LiDAR range from time-of-flight delta time."
    equations:
      - { name: "lidar_range", expr: "c_light*tof_dt/2", variables: ["c_light", "tof_dt"] }
    constraints: ["c_light>0", "tof_dt>=0", "isfinite(c_light) and isfinite(tof_dt)"]
    outputs: [{ id: "lidar_range", unit: "m" }]

  - id: "metrology_lidar_range_noise_from_jitter"
    domain: "metrology"
    purpose: "Range noise standard deviation induced by timing jitter."
    equations:
      - { name: "range_noise", expr: "c_light*timing_jitter/2", variables: ["c_light", "timing_jitter"] }
    constraints: ["c_light>0", "timing_jitter>=0", "isfinite(c_light) and isfinite(timing_jitter)"]
    outputs: [{ id: "range_noise", unit: "m" }]

  - id: "metrology_angular_step_to_arc_spacing"
    domain: "metrology"
    purpose: "Arc spacing from angular step at a given range."
    equations:
      - { name: "arc_spacing", expr: "lidar_range*angular_step", variables: ["lidar_range", "angular_step"] }
    constraints: ["lidar_range>=0", "angular_step>0", "isfinite(lidar_range) and isfinite(angular_step)"]
    outputs: [{ id: "arc_spacing", unit: "m" }]

  - id: "metrology_uncertainty_rss_and_expanded"
    domain: "metrology"
    purpose: "Combine uncertainty components by RSS and compute expanded uncertainty with explicit coverage factor."
    equations:
      - { name: "combined_uncertainty", expr: "sqrt((u_component_1^2)+(u_component_2^2)+(u_component_3^2))", variables: ["u_component_1", "u_component_2", "u_component_3"] }
      - { name: "expanded_uncertainty_u95", expr: "coverage_factor_k*sqrt((u_component_1^2)+(u_component_2^2)+(u_component_3^2))", variables: ["coverage_factor_k", "u_component_1", "u_component_2", "u_component_3"] }
    constraints:
      - "u_component_1>=0 and u_component_2>=0 and u_component_3>=0"
      - "coverage_factor_k>0"
      - "((u_component_1^2)+(u_component_2^2)+(u_component_3^2))>=0"
      - "isfinite(coverage_factor_k) and isfinite(u_component_1) and isfinite(u_component_2) and isfinite(u_component_3)"
    outputs:
      - { id: "combined_uncertainty", unit: "m" }
      - { id: "expanded_uncertainty_u95", unit: "m" }

  - id: "metrology_motion_blur_position_error"
    domain: "metrology"
    purpose: "Position error due to motion during exposure/integration."
    equations:
      - { name: "motion_blur_error", expr: "scan_speed*exposure_time", variables: ["scan_speed", "exposure_time"] }
    constraints: ["scan_speed>=0", "exposure_time>=0", "isfinite(scan_speed) and isfinite(exposure_time)"]
    outputs: [{ id: "motion_blur_error", unit: "m" }]

  - id: "metrology_trigger_jitter_position_error"
    domain: "metrology"
    purpose: "Position error due to trigger timing jitter at speed."
    equations:
      - { name: "trigger_jitter_error", expr: "scan_speed*trigger_jitter", variables: ["scan_speed", "trigger_jitter"] }
    constraints: ["scan_speed>=0", "trigger_jitter>=0", "isfinite(scan_speed) and isfinite(trigger_jitter)"]
    outputs: [{ id: "trigger_jitter_error", unit: "m" }]

  - id: "metrology_pointcloud_size_and_io_time"
    domain: "metrology"
    purpose: "Deterministic planning for point cloud size and I/O time."
    equations:
      - { name: "pointcloud_size", expr: "point_count*point_size_bytes", variables: ["point_count", "point_size_bytes"] }
      - { name: "io_time", expr: "(point_count*point_size_bytes)/io_bandwidth", variables: ["point_count", "point_size_bytes", "io_bandwidth"] }
    constraints:
      - "point_count>=0"
      - "point_size_bytes>0"
      - "io_bandwidth>0"
      - "(io_bandwidth)!=0"
      - "isfinite(point_count) and isfinite(point_size_bytes) and isfinite(io_bandwidth)"
    outputs:
      - { id: "pointcloud_size", unit: "B" }
      - { id: "io_time", unit: "s" }

  - id: "composites_tex_to_linear_mass_density"
    domain: "composites_3d_woven"
    purpose: "Convert tex to linear mass density."
    equations:
      - { name: "yarn_linear_mass_density", expr: "yarn_tex*1.0e-6", variables: ["yarn_tex"], assumptions: ["1 tex = 1 g/km = 1e-6 kg/m."] }
    constraints: ["yarn_tex>0", "isfinite(yarn_tex)"]
    outputs: [{ id: "yarn_linear_mass_density", unit: "kg/m" }]

  - id: "composites_warp_weft_binder_linear_mass"
    domain: "composites_3d_woven"
    purpose: "Convert warp/weft/binder tex to linear mass density."
    equations:
      - { name: "warp_linear_mass_density", expr: "warp_tex*1.0e-6", variables: ["warp_tex"], assumptions: ["1 tex = 1e-6 kg/m."] }
      - { name: "weft_linear_mass_density", expr: "weft_tex*1.0e-6", variables: ["weft_tex"], assumptions: ["1 tex = 1e-6 kg/m."] }
      - { name: "binder_linear_mass_density", expr: "binder_tex*1.0e-6", variables: ["binder_tex"], assumptions: ["1 tex = 1e-6 kg/m."] }
    constraints: ["warp_tex>0", "weft_tex>0", "binder_tex>0", "isfinite(warp_tex) and isfinite(weft_tex) and isfinite(binder_tex)"]
    outputs:
      - { id: "warp_linear_mass_density", unit: "kg/m" }
      - { id: "weft_linear_mass_density", unit: "kg/m" }
      - { id: "binder_linear_mass_density", unit: "kg/m" }

  - id: "composites_areal_mass_contributions"
    domain: "composites_3d_woven"
    purpose: "Areal mass contributions from yarn linear mass density and count density."
    equations:
      - { name: "warp_areal_mass", expr: "warp_ends_per_meter*warp_linear_mass_density", variables: ["warp_ends_per_meter", "warp_linear_mass_density"] }
      - { name: "weft_areal_mass", expr: "weft_picks_per_meter*weft_linear_mass_density", variables: ["weft_picks_per_meter", "weft_linear_mass_density"] }
      - { name: "binder_areal_mass", expr: "binder_ends_per_meter*binder_linear_mass_density", variables: ["binder_ends_per_meter", "binder_linear_mass_density"] }
    constraints:
      - "warp_ends_per_meter>0 and weft_picks_per_meter>0 and binder_ends_per_meter>=0"
      - "warp_linear_mass_density>0 and weft_linear_mass_density>0 and binder_linear_mass_density>0"
      - "isfinite(warp_ends_per_meter) and isfinite(weft_picks_per_meter) and isfinite(binder_ends_per_meter)"
      - "isfinite(warp_linear_mass_density) and isfinite(weft_linear_mass_density) and isfinite(binder_linear_mass_density)"
    outputs:
      - { id: "warp_areal_mass", unit: "kg/m^2" }
      - { id: "weft_areal_mass", unit: "kg/m^2" }
      - { id: "binder_areal_mass", unit: "kg/m^2" }

  - id: "composites_total_fiber_areal_mass"
    domain: "composites_3d_woven"
    purpose: "Total fiber areal mass from warp/weft/binder contributions."
    equations:
      - { name: "fiber_areal_mass_total", expr: "warp_areal_mass+weft_areal_mass+binder_areal_mass", variables: ["warp_areal_mass", "weft_areal_mass", "binder_areal_mass"] }
    constraints: ["warp_areal_mass>=0 and weft_areal_mass>=0 and binder_areal_mass>=0", "isfinite(warp_areal_mass) and isfinite(weft_areal_mass) and isfinite(binder_areal_mass)"]
    outputs: [{ id: "fiber_areal_mass_total", unit: "kg/m^2" }]

  - id: "composites_fiber_volume_fraction_from_areal_mass"
    domain: "composites_3d_woven"
    purpose: "Fiber volume fraction from total fiber areal mass, fiber density, and preform thickness."
    equations:
      - { name: "fiber_volume_fraction", expr: "fiber_areal_mass_total/(fiber_density*preform_thickness)", variables: ["fiber_areal_mass_total", "fiber_density", "preform_thickness"] }
    constraints:
      - "fiber_areal_mass_total>=0"
      - "fiber_density>0"
      - "preform_thickness>0"
      - "(fiber_density*preform_thickness)!=0"
      - "isfinite(fiber_areal_mass_total) and isfinite(fiber_density) and isfinite(preform_thickness)"
    outputs: [{ id: "fiber_volume_fraction", unit: "1" }]

  - id: "composites_matrix_void_closure"
    domain: "composites_3d_woven"
    purpose: "Matrix fraction via closure with explicit void fraction input."
    equations:
      - { name: "matrix_volume_fraction", expr: "1-fiber_volume_fraction-void_volume_fraction", variables: ["fiber_volume_fraction", "void_volume_fraction"] }
    constraints:
      - "fiber_volume_fraction>=0 and fiber_volume_fraction<=1"
      - "void_volume_fraction>=0 and void_volume_fraction<=1"
      - "(1-fiber_volume_fraction-void_volume_fraction)>=0"
      - "isfinite(fiber_volume_fraction) and isfinite(void_volume_fraction)"
    outputs: [{ id: "matrix_volume_fraction", unit: "1" }]

  - id: "composites_crimp_efficiency_template"
    domain: "composites_3d_woven"
    purpose: "Crimp/undulation efficiency template (calibration required)."
    equations:
      - { name: "crimp_efficiency", expr: "exp(-crimp_k*(crimp_angle^2))", variables: ["crimp_k", "crimp_angle"], assumptions: ["Template only; effective crimp_angle definition must match calibration protocol."] }
    constraints: ["crimp_k>=0", "crimp_angle>=0 and crimp_angle<pi/2", "isfinite(crimp_k) and isfinite(crimp_angle)"]
    calibration:
      required: true
      storage_path: "manufacturing/calibration/composites_crimp_efficiency_template/calibration.yaml"
      parameters: [{ id: "crimp_k", unit: "1" }]
      data_requirements:
        - "Measured effective stiffness/strength reduction vs crimp_angle for the specific architecture (warp/weft/binder)."
        - "Explicit definition of crimp_angle and measurement method recorded in calibration artifact."
    outputs: [{ id: "crimp_efficiency", unit: "1" }]

  - id: "composites_compaction_law_template"
    domain: "composites_3d_woven"
    purpose: "Preform compaction law template (calibration required)."
    equations:
      - { name: "compacted_thickness", expr: "preform_thickness-(compaction_k*ln(1+(compaction_pressure/compaction_p_ref)))", variables: ["preform_thickness", "compaction_k", "compaction_pressure", "compaction_p_ref"], assumptions: ["Template only; captures logarithmic compaction response."] }
    constraints:
      - "preform_thickness>0"
      - "compaction_k>=0"
      - "compaction_pressure>=0"
      - "compaction_p_ref>0"
      - "(compaction_pressure/compaction_p_ref)>=0"
      - "(1+(compaction_pressure/compaction_p_ref))>0"
      - "isfinite(preform_thickness) and isfinite(compaction_k) and isfinite(compaction_pressure) and isfinite(compaction_p_ref)"
    calibration:
      required: true
      storage_path: "manufacturing/calibration/composites_compaction_law_template/calibration.yaml"
      parameters:
        - { id: "compaction_k", unit: "m" }
        - { id: "compaction_p_ref", unit: "Pa" }
      data_requirements:
        - "Measured thickness vs compaction_pressure for the preform architecture (temperature/humidity/process state recorded)."
        - "Calibration scope and validity bounds documented in calibration artifact (no thresholds stored in mathlib)."
    outputs: [{ id: "compacted_thickness", unit: "m" }]

  - id: "structures_beam_bending_stress"
    domain: "structures"
    purpose: "Beam bending stress at distance c from neutral axis: sigma = M*c/I."
    equations:
      - { name: "bending_stress", expr: "bending_moment*neutral_axis_c/second_moment_i", variables: ["bending_moment", "neutral_axis_c", "second_moment_i"] }
    constraints: ["neutral_axis_c>0", "second_moment_i>0", "(second_moment_i)!=0", "isfinite(bending_moment) and isfinite(neutral_axis_c) and isfinite(second_moment_i)"]
    outputs: [{ id: "bending_stress", unit: "Pa" }]

  - id: "structures_beam_shear_stress"
    domain: "structures"
    purpose: "Beam shear stress: tau = V*Q/(I*b)."
    equations:
      - { name: "shear_stress", expr: "shear_force*first_moment_q/(second_moment_i*section_width)", variables: ["shear_force", "first_moment_q", "second_moment_i", "section_width"] }
    constraints: ["second_moment_i>0", "section_width>0", "(second_moment_i*section_width)!=0", "isfinite(shear_force) and isfinite(first_moment_q) and isfinite(second_moment_i) and isfinite(section_width)"]
    outputs: [{ id: "shear_stress", unit: "Pa" }]

  - id: "structures_plate_buckling_stress_template"
    domain: "structures"
    purpose: "Plate buckling critical stress template with explicit k input."
    equations:
      - { name: "plate_buckling_stress", expr: "(buckling_k*(pi^2)*youngs_modulus/(12*(1-(poisson_ratio^2))))*((plate_thickness/plate_span)^2)", variables: ["buckling_k", "youngs_modulus", "poisson_ratio", "plate_thickness", "plate_span"], assumptions: ["Linear elastic thin plate theory template; plate_span is characteristic dimension for the chosen k."] }
    constraints: ["buckling_k>0", "youngs_modulus>0", "plate_thickness>0", "plate_span>0", "(1-(poisson_ratio^2))!=0", "(1-(poisson_ratio^2))>0", "isfinite(buckling_k) and isfinite(youngs_modulus) and isfinite(poisson_ratio) and isfinite(plate_thickness) and isfinite(plate_span)"]
    outputs: [{ id: "plate_buckling_stress", unit: "Pa" }]

