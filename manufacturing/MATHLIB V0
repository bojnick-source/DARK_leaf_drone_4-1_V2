    forbid_implicit_units: true
    unit_expression: { multiplication: "*", division: "/", exponent: "^", parentheses: "()", whitespace: "forbidden" }

conventions:
  identifiers:
    variable_id_pattern: "^[a-z][a-z0-9_]{2,63}$"
    model_id_pattern: "^[a-z][a-z0-9_]{2,63}$"
    source_id_pattern: "^[a-z][a-z0-9_\\-]{2,63}$"
    reserved_prefixes: ["sys_", "internal_"]
  domains:
    allowed_domains: ["risf", "additive", "subtractive", "metrology", "composites_3d_woven", "structures"]
  paths:
    calibration_storage_root: "manufacturing/calibration"
    empirical_model_storage_hint: "manufacturing/calibration/<model_id>/calibration.yaml"
    hashes_storage_hint: "manufacturing/calibration/<model_id>/hashes.json"
  determinism:
    numeric_type: "float64"
    nan_policy: "forbidden"
    inf_policy: "forbidden"
    signed_zero_policy: "canonicalize_to_plus_zero"
    rounding: { mode: "HALF_EVEN", decimals_default: 12, clamp_negative_zero: true }
    canonical_number_format:
      style: "decimal_or_scientific"
      scientific_when_abs_ge: 1000000000.0
      scientific_when_abs_lt: 0.000001
      max_decimals: 12
    canonicalization:
      map_key_order: "lexicographic"
      list_order: "preserve_declared"
      string_normalization: "NFC"
      forbid_yaml_anchors: true
      forbid_non_finite_numbers: true
      line_endings: "LF"
    hashing:
      algorithm: "SHA-256"
      canonical_input: "canonical-json-from-yaml"
      include_sections: ["meta", "units", "conventions", "variable_registry", "models", "research_sources", "tripwires"]
      exclude_paths: ["meta.build"]
  expression_language:
    id: "mathlib_expr_v1"
    allowlist:
      operators: ["+", "-", "*", "/", "^", "<", "<=", ">", ">=", "==", "!=", "and", "or", "not"]
      functions: ["abs", "min", "max", "clamp", "sqrt", "exp", "ln", "log10", "pow", "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "floor", "ceil", "round", "isfinite"]
      constants: ["pi", "e"]
      literals: { allow_integers: true, allow_decimals: true, allow_scientific_notation: true }
    denylist:
      tokens: ["__", "import", "eval", "exec", "lambda", "while", "for", "class", "def", "globals", "locals", "open", "read", "write", "system", "os", "subprocess", "socket", "http", "https", "file:", "data:", "javascript:"]
      patterns: ["(?i)\\b(system|subprocess|os\\.|socket|requests|http)\\b"]
    safety_guards:
      forbid_divide_by_zero: true
      forbid_sqrt_of_negative: true
      forbid_ln_of_nonpositive: true
      forbid_log10_of_nonpositive: true
      forbid_non_finite_intermediates: true
      require_domain_guards: true
      require_exp_bounded_argument: false

