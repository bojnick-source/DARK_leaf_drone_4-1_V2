    - { id: "J/m", name: "joules_per_meter", symbol: "J/m", quantity: "energy_per_length", dimension: { L: 1, M: 1, T: -2, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "J/m^2", name: "joules_per_square_meter", symbol: "J/m^2", quantity: "energy_per_area", dimension: { L: 0, M: 1, T: -2, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "J/m^3", name: "joules_per_cubic_meter", symbol: "J/m^3", quantity: "energy_per_volume", dimension: { L: -1, M: 1, T: -2, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
