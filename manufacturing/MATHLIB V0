  schema: { id: "manufacturing.mathlib", version: "0" }
  scope:
    program: "Manufacturing math library (auditable, deterministic, safety-guarded)"
    intent: "Reusable, unit-safe variables + models for manufacturing engineering domains"
    exclusions:
      - "No acceptance thresholds in this file (belongs in process specs / calibration artifacts)"
      - "No hard-coded empirical coefficients without explicit calibration requirements + storage_path"
      - "No media-derived coefficients or thresholds"
  build: { chunk: 5, name: "Subtractive models", state: "COMPLETE" }

