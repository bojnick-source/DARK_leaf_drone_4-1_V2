      toggles:
        enforce_units: false
        enforce_domains: false
        enforce_equation_safety: false
        enforce_numeric_sanity: false
        enforce_authority_rules: false
        enforce_calibration_rules: false
        enforce_determinism: false
  rules:
    - id: "MEDIA_REFERENCE_GUARD"
      intent: "Media may exist only under research_sources.research_leads and must never be referenced by models or used for coefficients/thresholds."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
    - id: "DOMAIN_ALLOWLIST"
      intent: "Each model.domain must be in conventions.domains.allowed_domains."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
    - id: "EQUATION_SAFETY"
      intent: "Expressions must conform to conventions.expression_language allowlist/denylist and must satisfy required domain guards for divide/sqrt/ln/log10/exp."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
    - id: "NUMERIC_SANITY"
      intent: "Forbid NaN/Inf, forbid non-finite intermediates, and canonicalize negative zero."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
    - id: "CALIBRATION_REQUIRED"
      intent: "Empirical templates must declare calibration with explicit requirements and storage_path; non-empirical models must not declare calibration."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
    - id: "DETERMINISM_CANON"
      intent: "Determinism rules must be explicit and hashing must exclude meta.build while covering all other sections."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
meta:
