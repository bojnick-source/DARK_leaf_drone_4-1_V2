meta:
  title: "MANUFACTURING MATHLIB V0"
  schema:
    id: "manufacturing.mathlib"
    version: "0"
  scope:
    program: "Manufacturing math library (auditable, deterministic, safety-guarded)"
    intent: "Reusable, unit-safe variables + models for manufacturing engineering domains"
    exclusions:
      - "No acceptance thresholds in this file (belongs in process specs / calibration artifacts)"
      - "No hard-coded empirical coefficients without explicit calibration requirements + storage_path"
      - "No media-derived coefficients or thresholds"
  build:
    chunk: 1
    name: "Base skeleton"
    state: "COMPLETE"

units:
  system: "SI"
  base_dimensions:
    L: "length"
    M: "mass"
    T: "time"
    I: "electric_current"
    TH: "thermodynamic_temperature"
    N: "amount_of_substance"
    J: "luminous_intensity"
  prefixes:
    - { id: "nano",  name: "nano",  symbol: "n",  factor: 1.0e-9 }
    - { id: "micro", name: "micro", symbol: "u",  factor: 1.0e-6 }
    - { id: "milli", name: "milli", symbol: "m",  factor: 1.0e-3 }
    - { id: "centi", name: "centi", symbol: "c",  factor: 1.0e-2 }
    - { id: "deci",  name: "deci",  symbol: "d",  factor: 1.0e-1 }
    - { id: "deka",  name: "deka",  symbol: "da", factor: 1.0e1 }
    - { id: "hecto", name: "hecto", symbol: "h",  factor: 1.0e2 }
    - { id: "kilo",  name: "kilo",  symbol: "k",  factor: 1.0e3 }
    - { id: "mega",  name: "mega",  symbol: "M",  factor: 1.0e6 }
    - { id: "giga",  name: "giga",  symbol: "G",  factor: 1.0e9 }

  base_units:
    - id: "m"
      name: "meter"
      symbol: "m"
      quantity: "length"
      dimension: { L: 1, M: 0, T: 0, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "kg"
      name: "kilogram"
      symbol: "kg"
      quantity: "mass"
      dimension: { L: 0, M: 1, T: 0, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "s"
      name: "second"
      symbol: "s"
      quantity: "time"
      dimension: { L: 0, M: 0, T: 1, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "A"
      name: "ampere"
      symbol: "A"
      quantity: "electric_current"
      dimension: { L: 0, M: 0, T: 0, I: 1, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "K"
      name: "kelvin"
      symbol: "K"
      quantity: "thermodynamic_temperature"
      dimension: { L: 0, M: 0, T: 0, I: 0, TH: 1, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "mol"
      name: "mole"
      symbol: "mol"
      quantity: "amount_of_substance"
      dimension: { L: 0, M: 0, T: 0, I: 0, TH: 0, N: 1, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "cd"
      name: "candela"
      symbol: "cd"
      quantity: "luminous_intensity"
      dimension: { L: 0, M: 0, T: 0, I: 0, TH: 0, N: 0, J: 1 }
      to_SI: { scale: 1.0, offset: 0.0 }

  derived_units:
    - id: "1"
      name: "dimensionless"
      symbol: "1"
      quantity: "dimensionless"
      dimension: { L: 0, M: 0, T: 0, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "rad"
      name: "radian"
      symbol: "rad"
      quantity: "plane_angle"
      dimension: { L: 0, M: 0, T: 0, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "deg"
      name: "degree"
      symbol: "deg"
      quantity: "plane_angle"
      dimension: { L: 0, M: 0, T: 0, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 0.017453292519943295, offset: 0.0 }
    - id: "Hz"
      name: "hertz"
      symbol: "Hz"
      quantity: "frequency"
      dimension: { L: 0, M: 0, T: -1, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "N"
      name: "newton"
      symbol: "N"
      quantity: "force"
      dimension: { L: 1, M: 1, T: -2, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "Pa"
      name: "pascal"
      symbol: "Pa"
      quantity: "pressure"
      dimension: { L: -1, M: 1, T: -2, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "J"
      name: "joule"
      symbol: "J"
      quantity: "energy"
      dimension: { L: 2, M: 1, T: -2, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }
    - id: "W"
      name: "watt"
      symbol: "W"
      quantity: "power"
      dimension: { L: 2, M: 1, T: -3, I: 0, TH: 0, N: 0, J: 0 }
      to_SI: { scale: 1.0, offset: 0.0 }

  formatting:
    canonical_unit_id_case: "preserve"
    preferred_micro_symbol: "u"
    forbid_implicit_units: true
    unit_expression:
      multiplication: "*"
      division: "/"
      exponent: "^"
      parentheses: "()"
      whitespace: "forbidden"

conventions:
  identifiers:
    variable_id_pattern: "^[a-z][a-z0-9_]{2,63}$"
    model_id_pattern: "^[a-z][a-z0-9_]{2,63}$"
    source_id_pattern: "^[a-z][a-z0-9_\\-]{2,63}$"
    reserved_prefixes: ["sys_", "internal_"]

  domains:
    allowed_domains:
      - "risf"
      - "additive"
      - "subtractive"
      - "metrology"
      - "composites_3d_woven"
      - "structures"

  paths:
    calibration_storage_root: "manufacturing/calibration"
    empirical_model_storage_hint: "manufacturing/calibration/<model_id>/calibration.yaml"
    hashes_storage_hint: "manufacturing/calibration/<model_id>/hashes.json"

  determinism:
    numeric_type: "float64"
    nan_policy: "forbidden"
    inf_policy: "forbidden"
    signed_zero_policy: "canonicalize_to_plus_zero"
    rounding:
      mode: "HALF_EVEN"
      decimals_default: 12
      clamp_negative_zero: true
    canonical_number_format:
      style: "decimal_or_scientific"
      scientific_when_abs_ge: 1000000000.0
      scientific_when_abs_lt: 0.000001
      max_decimals: 12
    canonicalization:
      map_key_order: "lexicographic"
      list_order: "preserve_declared"
      string_normalization: "NFC"
      forbid_yaml_anchors: true
      forbid_non_finite_numbers: true
      line_endings: "LF"
    hashing:
      algorithm: "SHA-256"
      canonical_input: "canonical-json-from-yaml"
      include_sections:
        - "meta"
        - "units"
        - "conventions"
        - "variable_registry"
        - "models"
        - "research_sources"
        - "tripwires"
      exclude_paths:
        - "meta.build"

  expression_language:
    id: "mathlib_expr_v1"
    allowlist:
      operators: ["+", "-", "*", "/", "^", "<", "<=", ">", ">=", "==", "!=", "and", "or", "not"]
      functions:
        - "abs"
        - "min"
        - "max"
        - "clamp"
        - "sqrt"
        - "exp"
        - "ln"
        - "log10"
        - "pow"
        - "sin"
        - "cos"
        - "tan"
        - "asin"
        - "acos"
        - "atan"
        - "atan2"
        - "floor"
        - "ceil"
        - "round"
        - "isfinite"
      constants: ["pi", "e"]
      literals:
        allow_integers: true
        allow_decimals: true
        allow_scientific_notation: true
    denylist:
      tokens:
        - "__"
        - "import"
        - "eval"
        - "exec"
        - "lambda"
        - "while"
        - "for"
        - "class"
        - "def"
        - "globals"
        - "locals"
        - "open"
        - "read"
        - "write"
        - "system"
        - "os"
        - "subprocess"
        - "socket"
        - "http"
        - "https"
        - "file:"
        - "data:"
        - "javascript:"
      patterns:
        - "(?i)\\b(system|subprocess|os\\.|socket|requests|http)\\b"
    safety_guards:
      forbid_divide_by_zero: true
      forbid_sqrt_of_negative: true
      forbid_ln_of_nonpositive: true
      forbid_log10_of_nonpositive: true
      forbid_non_finite_intermediates: true
      require_domain_guards: true
      require_exp_bounded_argument: true

variable_registry: []

models: []

research_sources:
  policy:
    media_allowed_only_under_research_leads: true
    models_must_not_reference_research_leads: true
    forbid_media_for_coefficients_or_thresholds: true
  authoritative:
    entries: []
    model_map: []
  research_leads:
    entries: []

tripwires:
  active_profile: "STRICT"
  toggles:
    enforce_units: true
    enforce_domains: true
    enforce_equation_safety: true
    enforce_numeric_sanity: true
    enforce_authority_rules: true
    enforce_calibration_rules: true
    enforce_determinism: true

  profiles:
    STRICT:
      toggles:
        enforce_units: true
        enforce_domains: true
        enforce_equation_safety: true
        enforce_numeric_sanity: true
        enforce_authority_rules: true
        enforce_calibration_rules: true
        enforce_determinism: true
    DEVELOPMENT:
      toggles:
        enforce_units: true
        enforce_domains: true
        enforce_equation_safety: true
        enforce_numeric_sanity: true
        enforce_authority_rules: false
        enforce_calibration_rules: true
        enforce_determinism: true
    OFF:
      toggles:
        enforce_units: false
        enforce_domains: false
        enforce_equation_safety: false
        enforce_numeric_sanity: false
        enforce_authority_rules: false
        enforce_calibration_rules: false
        enforce_determinism: false

  rules:
    - id: "MEDIA_REFERENCE_GUARD"
      intent: "Media may exist only under research_sources.research_leads and must never be referenced by models or used for coefficients/thresholds."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
    - id: "DOMAIN_ALLOWLIST"
      intent: "Each model.domain must be in conventions.domains.allowed_domains."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
    - id: "EQUATION_SAFETY"
      intent: "Expressions must conform to conventions.expression_language allowlist/denylist and must satisfy required domain guards for divide/sqrt/ln/log10/exp."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
    - id: "NUMERIC_SANITY"
      intent: "Forbid NaN/Inf, forbid non-finite intermediates, and canonicalize negative zero."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
    - id: "CALIBRATION_REQUIRED"
      intent: "Empirical templates must declare calibration with explicit requirements and storage_path; non-empirical models must not declare calibration."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
    - id: "DETERMINISM_CANON"
      intent: "Determinism rules must be explicit and hashing must exclude meta.build while covering all other sections."
      severity_by_profile: { STRICT: "FAIL", DEVELOPMENT: "FAIL", OFF: "OFF" }
