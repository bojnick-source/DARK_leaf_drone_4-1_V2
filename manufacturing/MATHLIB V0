tripwires:
  intent: "Fail-fast guardrails for determinism, safety, and scope integrity."
  severity_levels: ["info", "warn", "error"]
  invariants:
    - id: "only_allowed_top_level_keys"
      severity: "error"
      description: "File must contain only the allowed top-level keys."
      check: { type: "yaml_top_level_keys_exact", allowed: ["meta", "units", "conventions", "variable_registry", "models", "research_sources", "tripwires"] }
    - id: "forbid_yaml_anchors"
      severity: "error"
      description: "No YAML anchors/aliases (canonicalization and hashing stability)."
      check: { type: "forbid_yaml_anchors", enabled: true }
    - id: "hashing_must_exclude_meta_build"
      severity: "error"
      description: "Canonical hashing must exclude meta.build only (reproducible content hashes)."
      check: { type: "hash_config_matches", include_sections: ["meta", "units", "conventions", "variable_registry", "models", "research_sources", "tripwires"], exclude_paths: ["meta.build"] }
    - id: "forbid_non_finite"
      severity: "error"
      description: "No NaN/Inf in any numeric field; expression evaluation must forbid non-finite intermediates."
      check: { type: "numeric_finiteness", nan_policy: "forbidden", inf_policy: "forbidden", forbid_non_finite_intermediates: true }
    - id: "domains_must_be_allowlisted"
      severity: "error"
      description: "All declared domains must be in conventions.domains.allowed_domains."
      check: { type: "domain_allowlist_enforced", allowlist_path: "conventions.domains.allowed_domains", fields: ["variable_registry[].domains[]", "models[].domain"] }
    - id: "units_must_exist"
      severity: "error"
      description: "All referenced unit IDs must exist in units.base_units or units.derived_units."
      check: { type: "unit_reference_integrity", unit_id_paths: ["variable_registry[].unit", "models[].outputs[].unit", "models[].calibration.parameters[].unit"] }
    - id: "identifiers_must_match_patterns"
      severity: "error"
      description: "All ids must match configured patterns and must not use reserved prefixes."
      check:
        type: "identifier_policy"
        patterns:
          variable_id_pattern_path: "conventions.identifiers.variable_id_pattern"
          model_id_pattern_path: "conventions.identifiers.model_id_pattern"
          source_id_pattern_path: "conventions.identifiers.source_id_pattern"
        reserved_prefixes_path: "conventions.identifiers.reserved_prefixes"
        fields:
          - { kind: "variable", path: "variable_registry[].id" }
          - { kind: "model", path: "models[].id" }
          - { kind: "source", path: "research_sources.authoritative.entries[].id" }
    - id: "expression_language_guardrails"
      severity: "error"
      description: "Expressions must use only allowlisted operators/functions/constants and must not contain denylisted tokens/patterns."
      check:
        type: "expression_safety"
        expr_paths: ["models[].equations[].expr"]
        allowlist_path: "conventions.expression_language.allowlist"
        denylist_path: "conventions.expression_language.denylist"
        safety_guards_path: "conventions.expression_language.safety_guards"
    - id: "all_models_outputs_declared_in_registry"
      severity: "error"
      description: "Every model output id must exist in variable_registry and unit must match."
      check: { type: "model_outputs_match_registry", registry_path: "variable_registry", outputs_path: "models[].outputs" }
    - id: "all_equation_variables_declared_in_registry"
      severity: "error"
      description: "Every variable referenced by a model equation must exist in variable_registry."
      check: { type: "equation_variables_in_registry", registry_path: "variable_registry", variables_path: "models[].equations[].variables" }
    - id: "no_thresholds_or_acceptance_criteria"
      severity: "error"
      description: "Mathlib must not contain acceptance thresholds/limits; those belong in process specs and calibration artifacts."
      check:
        type: "forbid_semantic_patterns"
        paths: ["meta", "units", "conventions", "variable_registry", "models", "research_sources", "tripwires"]
        patterns:
          - "(?i)\\b(acceptance|reject|pass\\/fail|tolerance\\s*band|upper\\s*limit|lower\\s*limit|spec\\s*limit|CpK|Cpk|sigma\\s*level)\\b"
    - id: "calibration_required_models_must_have_storage_path"
      severity: "error"
      description: "If model.calibration.required is true, it must include storage_path under conventions.paths.calibration_storage_root."
      check:
        type: "calibration_storage_policy"
        required_flag_path: "models[].calibration.required"
        storage_path_path: "models[].calibration.storage_path"
        root_path: "conventions.paths.calibration_storage_root"
    - id: "forbid_unverified_coefficients"
      severity: "error"
      description: "Coefficient-kind variables must not be used unless their owning model is explicitly marked calibration.required=true."
      check:
        type: "coefficients_require_calibration"
        coefficient_kind: "coefficient"
        registry_path: "variable_registry"
        model_equations_path: "models[].equations"
        calibration_required_path: "models[].calibration.required"
    - id: "research_sources_must_not_be_required_at_runtime"
      severity: "error"
      description: "Models must not reference research leads/media sources in executable paths; only documentation linkage allowed."
      check:
        type: "forbid_cross_reference"
        forbidden_source_groups: ["research_sources.research_leads"]
        expr_paths: ["models[].equations[].expr", "models[].constraints[]", "models[].equations[].assumptions[]"]
  lint:
    canonicalization_expectations:
      map_key_order: "lexicographic"
      line_endings: "LF"
      string_normalization: "NFC"
      forbid_implicit_units: true
    required_fields:
      variable_registry: ["id", "unit", "kind", "domains", "domain_constraints"]
      models: ["id", "domain", "purpose", "equations", "constraints", "outputs"]
      research_sources_entries: ["id", "type", "status", "citation"]
  runtime_fail_fast:
    evaluation:
      enforce_domain_constraints: true
      enforce_model_constraints: true
      abort_on_first_error: true
      error_on_missing_variable_value: true
      error_on_unknown_unit: true
