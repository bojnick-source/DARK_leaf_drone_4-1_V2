    - { id: "m/s", name: "meters_per_second", symbol: "m/s", quantity: "speed", dimension: { L: 1, M: 0, T: -1, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
