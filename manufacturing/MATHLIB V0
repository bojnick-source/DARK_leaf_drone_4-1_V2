        - "Documented calibration procedure stored in artifact."
    outputs: [{ id: "haz_width", unit: "m" }]

  - id: "subtractive_laser_kerf_template"
    domain: "subtractive"
    purpose: "Laser kerf width template (calibration required)."
    equations:
      - { name: "kerf_width", expr: "laser_kerf_scale*exp(laser_kerf_k0+(laser_kerf_k1*ln(laser_power/laser_kerf_p_ref))+(laser_kerf_k2*ln(travel_speed/laser_kerf_v_ref)))", variables: ["laser_kerf_scale", "laser_kerf_k0", "laser_kerf_k1", "laser_kerf_k2", "laser_power", "laser_kerf_p_ref", "travel_speed", "laser_kerf_v_ref"] }
    constraints: ["laser_kerf_scale>0", "laser_kerf_p_ref>0", "laser_kerf_v_ref>0", "laser_power>0", "travel_speed>0", "(laser_power/laser_kerf_p_ref)>0", "(travel_speed/laser_kerf_v_ref)>0", "isfinite(laser_kerf_scale) and isfinite(laser_kerf_k0) and isfinite(laser_kerf_k1) and isfinite(laser_kerf_k2)", "isfinite(laser_power) and isfinite(laser_kerf_p_ref) and isfinite(travel_speed) and isfinite(laser_kerf_v_ref)"]
    calibration:
      required: true
      storage_path: "manufacturing/calibration/subtractive_laser_kerf_template/calibration.yaml"
      parameters:
        - { id: "laser_kerf_scale", unit: "m" }
        - { id: "laser_kerf_k0", unit: "1" }
        - { id: "laser_kerf_k1", unit: "1" }
        - { id: "laser_kerf_k2", unit: "1" }
        - { id: "laser_kerf_p_ref", unit: "W" }
        - { id: "laser_kerf_v_ref", unit: "m/s" }
      data_requirements:
        - "Measured kerf width vs (laser_power, travel_speed) for a fixed optics/material stack."
        - "Documented calibration procedure stored in artifact."
    outputs: [{ id: "kerf_width", unit: "m" }]

  - id: "subtractive_waterjet_hydraulic_power"
    domain: "subtractive"
    purpose: "Waterjet hydraulic power primitive (p*Q)."
    equations:
      - { name: "hydraulic_power", expr: "waterjet_pressure*water_flow_rate", variables: ["waterjet_pressure", "water_flow_rate"] }
    constraints: ["waterjet_pressure>0", "water_flow_rate>0", "isfinite(waterjet_pressure) and isfinite(water_flow_rate)"]
    outputs: [{ id: "hydraulic_power", unit: "W" }]

  - id: "subtractive_waterjet_abrasive_dose_per_length"
    domain: "subtractive"
    purpose: "Abrasive dose per unit length (mass_flow / travel_speed)."
    equations:
      - { name: "abrasive_dose_per_length", expr: "abrasive_mass_flow/travel_speed", variables: ["abrasive_mass_flow", "travel_speed"] }
    constraints: ["abrasive_mass_flow>=0", "travel_speed>0", "(travel_speed)!=0", "isfinite(abrasive_mass_flow) and isfinite(travel_speed)"]
    outputs: [{ id: "abrasive_dose_per_length", unit: "kg/m" }]

