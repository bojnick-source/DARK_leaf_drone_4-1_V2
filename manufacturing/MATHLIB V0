    - { id: "rad", name: "radian", symbol: "rad", quantity: "plane_angle", dimension: { L: 0, M: 0, T: 0, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "deg", name: "degree", symbol: "deg", quantity: "plane_angle", dimension: { L: 0, M: 0, T: 0, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 0.017453292519943295, offset: 0.0 } }
    - { id: "Hz", name: "hertz", symbol: "Hz", quantity: "frequency", dimension: { L: 0, M: 0, T: -1, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "N", name: "newton", symbol: "N", quantity: "force", dimension: { L: 1, M: 1, T: -2, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "Pa", name: "pascal", symbol: "Pa", quantity: "pressure", dimension: { L: -1, M: 1, T: -2, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
    - { id: "J", name: "joule", symbol: "J", quantity: "energy", dimension: { L: 2, M: 1, T: -2, I: 0, TH: 0, N: 0, J: 0 }, to_SI: { scale: 1.0, offset: 0.0 } }
